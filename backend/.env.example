DATABASE_URL=postgresql://user:password@host:5432/fifa
GROQ_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
# Optional. Leave unset for local dev -- only the deployed Container App should
# export telemetry, so local runs don't mix into the same Application Insights
# resource as production. Get the real value via:
#   az monitor app-insights component show -g rg-fifa26-dev --query "[0].connectionString" -o tsv
APPLICATIONINSIGHTS_CONNECTION_STRING=
