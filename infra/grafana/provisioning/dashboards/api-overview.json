      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azuremonitor" },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resource": "/subscriptions/e1c9219c-b619-4508-b9ba-7898eb104d6f/resourceGroups/rg-fifa26-dev/providers/Microsoft.OperationalInsights/workspaces/log-fifa26-dev",
            "query": "AppTraces\n| where Message has \"request method=\"\n| parse Message with \"request method=\" Method \" path=\" Path \" status=\" StatusCode:int \" duration_ms=\" DurationMs:double\n| summarize avg(DurationMs)"
          }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" }
