  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azuremonitor" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "azuremonitor" },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resource": "/subscriptions/e1c9219c-b619-4508-b9ba-7898eb104d6f/resourceGroups/rg-fifa26-dev/providers/Microsoft.OperationalInsights/workspaces/log-fifa26-dev",
            "query": "AppTraces\n| where Message has \"request method=\"\n| parse Message with \"request method=\" Method \" path=\" Path \" status=\" StatusCode:int \" duration_ms=\" DurationMs:double\n| count"
          }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg latency (ms)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
