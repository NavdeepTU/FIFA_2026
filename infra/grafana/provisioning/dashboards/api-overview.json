            "query": "AppTraces\n| where Message has \"request method=\"\n| parse Message with \"request method=\" Method \" path=\" Path \" status=\" StatusCode:int \" duration_ms=\" DurationMs:double\n| summarize RequestCount = count() by bin(TimeGenerated, 1h)\n| order by TimeGenerated asc"
